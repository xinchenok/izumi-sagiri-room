      "css": "@font-face{font-family:RoomBody;src:url(\"assets/fonts/v20/RoomBody.woff2\") format(\"woff2\");font-weight:400;font-display:swap}.ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:.55em;min-height:52px;border-radius:2rem;padding:.6rem 1.4rem;font-size:clamp(16px,1.2vw,20px);line-height:1.3;border:2px solid #fff;cursor:pointer;font-family:RoomBody,\"Microsoft YaHei\",sans-serif;font-weight:400;transition:transform .2s var(--ease,cubic-bezier(0.16,1,0.3,1))}.ds-primary:hover{transform:translateY(-2px)}.ds-primary:active{transform:translateY(1px)}.ds-primary:focus-visible{outline:3px solid var(--focus,#215c89);outline-offset:4px}@media(max-width:760px){.ds-primary{min-height:45px;font-size:14px;padding:.6rem .75rem}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;animation:none}}.ds-primary{background:var(--rose,#b74063);color:var(--paper,#fff9fa);min-width:12.6vw}.ds-action-arrow{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}"
